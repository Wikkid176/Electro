{
  "name": "electrolessonlab",
  "description": "Game-based industrial electrical training for mobile.",
  "version": "0.2.0",
  "main": "index.ts",
  "dependencies": {
    "@react-native-async-storage/async-storage": "^2.2.0",
    "expo": "~58.0.14",
    "expo-status-bar": "~58.0.3",
    "react": "19.3.0",
    "react-dom": "^19.3.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-web": "^0.21.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.19.2",
    "@types/react": "~19.3.0",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "export:web": "expo export --platform web",
    "test:e2e": "playwright test",
    "test:beta": "playwright test --config=playwright.beta.config.ts",
    "report:beta": "node --experimental-strip-types scripts/report-beta.ts",
    "beta:signing": "node scripts/prepare-android-signing.mjs",
    "beta:android": "bash scripts/build-android-beta.sh"
  },
  "private": true,
  "type": "module"
}
