# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local
.env
.env.*
!.env.example

# Private reference material stays outside the app and version control.
private-references/
*.zip

# Browser test outputs
test-results/
playwright-report/

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# Generated APKs and private signing material must not enter source control.
releases/android/*.apk
*.p12
*.pfx
*signing.properties

# Completed ownership agreements and legal correspondence are private.
/private-legal/
/docs/ownership/private/
